{
  "manifest_version": 3,
  "name": "My AdBlocker",
  "version": "1.3",
  "description": "A simple ad blocker based on EasyList, EasyPrivacy and Peter Lowe's list.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "webRequest",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "My AdBlocker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "easylist", "enabled": true, "path": "rules.json" }
    ]
  }
}
